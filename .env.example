# --- server locale ---
DOCBOOKLM_API_HOST=127.0.0.1
DOCBOOKLM_API_PORT=8078

# --- motore: router llama.cpp gia' attivo (Vulkan/MoltenVK) ---
DOCBOOKLM_ROUTER_URL=http://127.0.0.1:8080
# preset proposto all'avvio; si cambia dal selettore nell'interfaccia
DOCBOOKLM_DEFAULT_MODEL=Qwen3.5-9B-UD-Q4_K_XL

# --- dati ---
DOCBOOKLM_DATA_DIR=data
DOCBOOKLM_MAX_UPLOAD_MB=20

# --- estrazione ---
# OCR delle scansioni con Vision di macOS (italiano + inglese)
DOCBOOKLM_OCR_ENABLED=true
# link verso localhost e reti private bloccati (SSRF)
DOCBOOKLM_ALLOW_PRIVATE_URLS=false

# --- generazione ---
DOCBOOKLM_MAX_TOKENS=1200
DOCBOOKLM_TEMPERATURE=0.2
DOCBOOKLM_TOP_P=0.9
DOCBOOKLM_HISTORY_TURNS=4
# ragionamento visibile dei modelli Qwen3 (piu' lento, risposte piu' lunghe)
DOCBOOKLM_THINKING=false

DOCBOOKLM_LOG_LEVEL=INFO
