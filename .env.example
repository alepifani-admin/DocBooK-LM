# --- server locale ---
DOCBOOKLM_API_HOST=127.0.0.1
DOCBOOKLM_API_PORT=8078

# --- motore: router llama.cpp gia' attivo (Vulkan/MoltenVK) ---
DOCBOOKLM_ROUTER_URL=http://127.0.0.1:8080
# preset proposto all'avvio; si cambia dal selettore nell'interfaccia
DOCBOOKLM_DEFAULT_MODEL=Qwen3.5-9B-UD-Q4_K_XL

# --- dati ---
DOCBOOKLM_DATA_DIR=data
DOCBOOKLM_MAX_UPLOAD_MB=20

# --- estrazione ---
# OCR delle scansioni con Vision di macOS (italiano + inglese)
DOCBOOKLM_OCR_ENABLED=true
# link verso localhost e reti private bloccati (SSRF)
DOCBOOKLM_ALLOW_PRIVATE_URLS=false

# --- generazione ---
DOCBOOKLM_MAX_TOKENS=1200
DOCBOOKLM_TEMPERATURE=0.2
DOCBOOKLM_TOP_P=0.9
DOCBOOKLM_HISTORY_TURNS=4
# ragionamento dei modelli (Qwen3: enable_thinking, gpt-oss: reasoning_effort).
# Con true il ragionamento si mangia i max_tokens: alza MAX_TOKENS di conseguenza.
DOCBOOKLM_THINKING=false

# --- retrieval denso: due sidecar llama-server, fuori dal router di chat ---
# false = solo BM25 (utile per i test o su macchine senza GPU libera)
DOCBOOKLM_EMBED_ENABLED=true
# false = usa sidecar avviati a mano, senza processi figli
DOCBOOKLM_SIDECAR_ENABLED=true
DOCBOOKLM_EMBED_URL=http://127.0.0.1:8091
DOCBOOKLM_RERANK_URL=http://127.0.0.1:8092
# progetto llama.cpp con i binari Vulkan e i GGUF
DOCBOOKLM_LLAMA_DIR=/Users/alessandro/Documents/LLAMA.CPP
DOCBOOKLM_EMBED_MODEL=models-embed/bge-m3-Q8_0.gguf
DOCBOOKLM_RERANK_MODEL=models-embed/bge-reranker-v2-m3-Q8_0.gguf

DOCBOOKLM_LOG_LEVEL=INFO
